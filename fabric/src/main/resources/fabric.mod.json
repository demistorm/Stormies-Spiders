{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/stormies-spiders",
        "sources": "https://github.com/demistorm/stormies-spiders",
        "issues": "https://github.com/demistorm/stormies-spiders/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "win.demistorm.stormiespiders.StormiesSpiders"
        ],
        "client": [
            "win.demistorm.stormiespiders.fabric.FabricClientSetup"
        ],
        "modmenu": [
            "win.demistorm.stormiespiders.fabric.FabricConfigScreen"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=25"
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "accessWidener": "${mod_id}.accesswidener",
    "suggests": {
        "modmenu": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/7uttzPbTGq",
                "modmenu.kofi": "https://ko-fi.com/hstorm"
            }
        }
    }
}
